#!/usr/bin/env bash
set -Eeuo pipefail

LIVE_USER="burmolda"
LIVE_PASSWORD="burmolda"

# Current Arch images do not necessarily ship the historical audio/video/
# optical/storage groups. The Live session only needs the wheel group.
if ! getent group wheel >/dev/null 2>&1; then
  groupadd wheel
fi

if ! id "$LIVE_USER" >/dev/null 2>&1; then
  useradd --create-home --groups wheel --shell /bin/bash "$LIVE_USER"
fi

# A password is provided as a fallback if SDDM autologin is unavailable.
# This account exists only in the disposable Live ISO; users create their
# own credentials during installation.
printf '%s:%s\n' "$LIVE_USER" "$LIVE_PASSWORD" | chpasswd

install -d -o "$LIVE_USER" -g "$LIVE_USER" "/home/$LIVE_USER"
if [[ ! -e "/home/$LIVE_USER/.config/kdeglobals" ]]; then
  cp -a /etc/skel/. "/home/$LIVE_USER/"
fi
chown -R "$LIVE_USER:$LIVE_USER" "/home/$LIVE_USER"

echo "Burmolda Live user '$LIVE_USER' is ready."
